[Unit]
Description=Freight Equasis registry crawler (vessel data enrichment)
After=network.target

# Alert on failure. ~/CLAUDE.md: every batch unit carries this, because a timer-driven
# job exiting non-zero is seen by neither UptimeRobot nor Sentry - which is how the
# server-backup breakage hid for ten nights.
# A failed crawl is silent - the API serves whatever vessel_registry.duckdb already
# holds. Worth alerting on: repeated failures can mean the Equasis account is locked.
OnFailure=alert-email@%N.service

[Service]
Type=oneshot
User=lbzgiu
WorkingDirectory=/home/lbzgiu/quant/freight/backend
ExecStart=/home/lbzgiu/quant/freight/backend/.venv/bin/python -m registry.crawl
EnvironmentFile=-/home/lbzgiu/quant/freight/backend/.env
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
