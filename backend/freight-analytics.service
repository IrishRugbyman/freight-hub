# freight-analytics -- hourly analytics batch job for the freight hub.
#
# Install:
#   sudo cp ~/quant/freight/backend/freight-analytics.service /etc/systemd/system/
#   sudo cp ~/quant/freight/backend/freight-analytics.timer  /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now freight-analytics.timer
# Check:
#   systemctl status freight-analytics.service freight-analytics.timer
#   journalctl -u freight-analytics.service -n 50 --no-pager

[Unit]
Description=Freight hub analytics batch job (transit/anchored/density detection)
After=network-online.target

[Service]
Type=oneshot
User=lbzgiu
WorkingDirectory=/home/lbzgiu/quant/freight/backend
ExecStart=/home/lbzgiu/quant/freight/backend/.venv/bin/python -m analytics.build
StandardOutput=journal
StandardError=journal

# Memory guard. This job was OOM-killed three times (2026-07-20, 2026-07-26 x2) at
# 4.0-5.0 GB RSS on a 7.6 GB box; each was a GLOBAL OOM, where the kernel picks the
# largest process on the machine as the victim - postgres, the AIS collector and every
# other live service were in the blast radius. MemoryMax confines an overrun to a cgroup
# OOM that kills only this job. Swap is deliberately left unlimited: thrashing to a
# slow finish beats dying. Raise only alongside a real fix to the ETA stage's footprint.
MemoryAccounting=yes
MemoryMax=5G

[Install]
WantedBy=multi-user.target
