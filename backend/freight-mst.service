[Unit]
Description=Freight MyShipTracking crawler (voyage history + port calls enrichment)
After=network.target

# Alert on failure. ~/CLAUDE.md: every batch unit carries this, because a timer-driven
# job exiting non-zero is seen by neither UptimeRobot nor Sentry - which is how the
# server-backup breakage hid for ten nights.
# A failed crawl is silent - the API serves whatever mst.duckdb already holds.
# Repeated failures usually mean the scraper is being IP-rate-limited.
OnFailure=alert-email@%N.service

[Service]
Type=oneshot
User=lbzgiu
WorkingDirectory=/home/lbzgiu/quant/freight/backend
ExecStart=/home/lbzgiu/quant/freight/backend/.venv/bin/python -m registry.crawl_mst
EnvironmentFile=-/home/lbzgiu/quant/freight/backend/.env
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
