# freight-dest-retrain -- WEEKLY gated retrain of the destination-prediction reranker.
#
# The sibling of freight-eta-retrain, for the other gated challenger. `python -m
# analytics.destination_predict` trains the LightGBM "is this candidate the
# vessel's actual destination?" classifier on completed voyages, walk-forwards it
# against the transparent heuristic champion on a voyage-grouped time split, and
# promotes to serving only if it beats the heuristic's held-out top-1 accuracy
# without losing top-3. Otherwise the heuristic stays champion. Like the ETA
# retrain, it cannot make serving worse.
#
# Why it needs a timer: exactly the staleness the ETA challenger had. The artifact
# in service had been trained on 2026-07-04 against 40k labelled test groups while
# the ground truth grew to 89k. Retrained 2026-09-10 it still wins and promotes
# (heuristic top-1 0.647, ml 0.691), but nothing was re-deriving that on its own.
#
# Saturday, not Sunday: freight-eta-retrain runs Sun 02:20. Both take the same
# analytics flock, so sharing a night would only serialize them - but this job
# peaks at 4.35 GB against the ETA retrain's 1.5 GB, and this box has a documented
# history of GLOBAL OOMs where the kernel picks the largest process on the machine
# and takes postgres or the AIS collector with it. Separate nights keep the two
# peaks from ever coinciding with each other or with anything else.
#
# Install:
#   sudo cp ~/quant/freight/backend/freight-dest-retrain.{service,timer} /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now freight-dest-retrain.timer
# Check:
#   systemctl list-timers 'freight-dest-retrain*'
#   journalctl -u freight-dest-retrain.service -n 50 --no-pager

[Unit]
Description=Freight destination-predictor weekly gated ML retrain (LightGBM reranker)
After=network-online.target
# A silently stale champion changes nothing externally observable - the API keeps
# serving predictions from whichever model was last promoted. Alert on failure.
OnFailure=alert-email@%N.service

[Service]
Type=oneshot
User=lbzgiu
WorkingDirectory=/home/lbzgiu/quant/freight/backend
# Same lock as the analytics units: this writes a destination_model_metrics row.
# The long training phase itself runs through a READ-ONLY connection so it does
# not blank the live analytics endpoints - see analytics/eta_ml.py:run.
ExecStart=/usr/bin/flock -w 3600 /home/lbzgiu/quant/freight/backend/data/.analytics.lock /home/lbzgiu/quant/freight/backend/.venv/bin/python -m analytics.destination_predict
StandardOutput=journal
StandardError=journal

# Measured 2026-09-10 on 2.49M candidate rows / 130k voyages: 4.35 GB peak RSS,
# 24m30s wall (3311s CPU). Nearly all of it is build_training_candidates, which
# materialises the full candidate frame in memory. 6 GB gives that ~1.6 GB of
# headroom for label growth; the cap exists so an overrun becomes a cgroup OOM
# that kills only this job rather than a global one. Treat a cgroup OOM here as a
# signal to chunk the candidate build, not to raise the number.
MemoryAccounting=yes
MemoryMax=6G

[Install]
WantedBy=multi-user.target
