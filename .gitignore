# python
# no trailing slash: .venv is a symlink to the data-volume venv, not a real dir,
# and a trailing-slash pattern would not match a symlink.
backend/.venv
**/__pycache__/
*.pyc
backend/*.egg-info/
.pytest_cache/

# node / vite
frontend/node_modules/
frontend/dist/
frontend/src/routeTree.gen.ts

# env
.env
backend/data/
.playwright-mcp/
research/

# scratch / design assets
redesign-*.png

# ETA ML model artifacts (Phase D): regenerated by `python -m analytics.eta_ml`
# and the weekly retrain; serving falls back to physics if absent.
backend/analytics/models/
